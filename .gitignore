# Python temporary files
__pycache__/
*.py[cod]

# VS Code settings
.vscode/

# Large video files (Optional - keep repo light)
videos/
*.mp4
*.avi

# Virtual Environments (if you have one)
env/
venv/
.venv/

# Claude AI workspace — ignore runtime state, keep skills
.claude/
!.claude/skills/
!.claude/skills/**

# Claude credentials and sensitive config
.claude/.credentials.json

# Temporary Google Drive upload cache
.tmp.driveupload/

# Compiled/distributed Python
*.egg-info/
dist/
build/
*.egg

# Legacy cruft — prevent re-introduction
*.pkl
*_backup*.py
back_processing_log.txt
test_results_pipeline.txt
workout_*.json
skeleton_screenshot_*.jpg
test_visualization.jpg
Untitled*.ipynb

# Stage 3 calibrator runtime outputs (committed seed_thresholds.json stays)
exercises/*/heuristic_thresholds.json
exercises/*/calibration_log.json

# Stage 6b — YOLOv8 weights are fetched at install time, never committed
models/*.pt
models/*.onnx

# Trained CNN+LSTM form-scorer weights — never commit trained models (cf. *.pkl).
# Regenerate with: python -m training.train_cnn_lstm
*.pt
*.pth

# Rep-counter diagnostic traces / plots — regenerate via tools/diagnose_rep_counter.py.
# (calibration/ ground-truth CSVs are NOT ignored — they are human input, committed.)
diagnostics/

# Frontend (React/Vite + Node/Express) — track SOURCE only, never deps/secrets/db/logs.
# (frontend/web_app/FYP1/.gitignore also covers these; this is the repo-level net so
#  protection survives even if that nested .gitignore is ever removed.)
frontend/**/node_modules/
frontend/**/dist/
frontend/**/dist-ssr/
frontend/**/.env
frontend/**/.env.*
frontend/**/*.sqlite
frontend/**/*.sqlite-journal
frontend/**/*.log
frontend/**/sqlmap_*.log